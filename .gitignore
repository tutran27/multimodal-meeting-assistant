# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# Environments & Dependencies
.venv/
venv/
ENV/
env/
lib/
bin/
include/
share/

# Secret & Configuration files
.env
.env.*
!.env.example
**/credentials.json
**/token*.json
**/*credentials*.json
**/.streamlit/secrets.toml

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
.ipynb_checkpoints/
**/checkpoints/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Project-specific directories (Ignore contents but keep the folder structure via .gitkeep)
credentials/*
!credentials/.gitkeep

logs/*
!logs/.gitkeep

outputs/*
!outputs/.gitkeep

data/temp/*
!data/temp/.gitkeep

data/inputs/*
!data/inputs/.gitkeep

# Local data / mock databases (optional - remove if you want to commit seed data)
data/contacts.json
