# ==========================================
# Secrets, Tokens & Environment Files
# ==========================================
.env
.env.*
!.env.example
*.pem
*.key
**/*client_secret*.json
**/*token*.json
**/*credentials*.json
**/.streamlit/secrets.toml

# ==========================================
# Database & Logs
# ==========================================
*.db
*.sqlite
*.sqlite3
*.log
logs/*
!logs/.gitkeep

# ==========================================
# Project Storage & Working Dirs
# ==========================================
outputs/*
!outputs/.gitkeep
data/inputs/*
!data/inputs/.gitkeep
data/temp/*
!data/temp/.gitkeep

# ==========================================
# Credentials Folder (Keep structure via .gitkeep)
# ==========================================
credentials/*
!credentials/.gitkeep

# ==========================================
